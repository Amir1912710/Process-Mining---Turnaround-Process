      "name": "TurnSeg",
      "type": "product",
      "definition": "colset TurnSeg = product Turnaround * TaxiSegment timed;",
      "color": "#b45309",
      "timed": true
    },
    {
      "id": "cs-flightstand",
      "name": "FlightStand",
      "type": "product",
      "definition": "colset FlightStand = product Flight * Stand timed;",
      "color": "#0d9488",
      "timed": true
    },
    {
      "id": "cs-turnfueller",
      "name": "TurnFueller",
      "type": "product",
      "definition": "colset TurnFueller = product Turnaround * Fueller timed;",
      "color": "#dc2626",
