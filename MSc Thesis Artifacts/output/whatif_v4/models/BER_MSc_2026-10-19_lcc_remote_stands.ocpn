      "transitions": [
        {
          "id": "r-t-unload-start",
          "name": "Baggage Unload\nStart",
          "guard": "loader_fits(ldr.kind, tr.hold)",
          "time": "",
          "priority": "",
          "codeSegment": "",
          "position": {
            "x": 280,
            "y": 200
          },
          "size": {
            "width": 50,
            "height": 30
          },
          "includeInOcel": true
        },
        {
          "id": "r-t-unload-end",
          "name": "Baggage Unload\nComplete",
          "guard": "",
          "time": "",
          "priority": "",
          "codeSegment": "// The boxes that came out of the hold are real containers from the pool.\nlet picked = pick_ulds(pool, tr.arr.aircraft.body, tr.nUlds);\nlet tr2 = tr;\ntr2.ulds = picked;",
          "position": {
            "x": 760,
            "y": 200
          },
          "size": {
            "width": 50,
            "height": 30
          },
          "includeInOcel": true
        },
        {
          "id": "r-t-load-start",
          "name": "Baggage Load\nStart",
          "guard": "loader_fits(ldr.kind, tr.hold)",
          "time": "",
          "priority": "",
          "codeSegment": "",
          "position": {
            "x": 1300,
            "y": 200
          },
          "size": {
            "width": 50,
            "height": 30
          },
          "includeInOcel": true
        },
        {
          "id": "r-t-load-end",
          "name": "Hold Closed",
          "guard": "",
          "time": "",
          "priority": "",
          "codeSegment": "// Outbound containers, again from the pool; the turnaround ends up carrying every\n// box it handled, inbound and outbound.\nlet more = pick_ulds(pool, tr.dep.aircraft.body, tr.nDepUlds);\nlet all = tr.ulds;\nfor b in more { all.push(b); }\nlet tr2 = tr;\ntr2.ulds = all;",
          "position": {
            "x": 1760,
            "y": 200
          },
          "size": {
            "width": 50,
            "height": 30
          },
          "includeInOcel": true
        },
