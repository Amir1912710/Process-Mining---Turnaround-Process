    },
    {
      "id": "cs-turnaround",
      "name": "Turnaround",
      "type": "record",
      "definition": "colset Turnaround = record id: STRING * arr: Flight * dep: Flight * stand: Stand * upliftL: INT * nUlds: INT * nDepUlds: INT * ulds: ULDs * hold: STRING * needCater: BOOL * needWater: BOOL timed;",
      "color": "#e11d48",
      "timed": true,
      "refs": [
