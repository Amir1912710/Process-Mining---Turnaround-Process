      "type": "basic",
      "definition": "colset STRING = string;",
      "color": "#8b5cf6"
    },
    {
      "id": "cs-aircraft",
      "name": "Aircraft",
      "type": "record",
      "definition": "colset Aircraft = record id: STRING * typeCode: STRING * codeLetter: STRING * body: STRING * seats: INT * fuelCapL: INT * airline: STRING timed;",
      "color": "#2563eb",
      "timed": true
    },
    {
      "id": "cs-flight",
      "name": "Flight",
      "type": "record",
      "definition": "colset Flight = record id: STRING * callsign: STRING * airline: STRING * carrierType: STRING * direction: STRING * schengen: BOOL * station: STRING * pax: INT * prm: INT * sectorMin: INT * aircraft: Aircraft * studyCase: STRING * pairedCallsign: STRING * pairedDestination: STRING * inputBasis: STRING * contextBasis: STRING * stdMs: INT timed;",
      "color": "#0ea5e9",
      "timed": true,
      "refs": [
        {
          "field": "aircraft",
          "target": "Aircraft",
          "qualifier": "operated by",
          "eventQualifier": "aircraft"
        }
      ]
    },
    {
      "id": "cs-stand",
      "name": "Stand",
      "type": "record",
      "definition": "colset Stand = record id: STRING * pier: STRING * contact: BOOL * maxCode: STRING * schengen: STRING * hydrant: BOOL * x: INT * y: INT * taxiIn: INT * taxiOut: INT timed;",
      "color": "#06b6d4",
      "timed": true
    },
    {
      "id": "cs-runway",
      "name": "Runway",
      "type": "record",
      "definition": "colset Runway = record id: STRING * name: STRING * lengthM: INT timed;",
