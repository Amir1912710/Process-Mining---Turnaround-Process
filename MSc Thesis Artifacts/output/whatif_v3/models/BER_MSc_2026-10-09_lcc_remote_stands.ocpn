  "simulationSettings": {
    "stepsPerRun": 1000,
    "animationDelayMs": 0,
    "simulationEpoch": "2026-10-09T00:00:00+00:00",
    "endTimeMs": 165008000,
    "keepAwakeWhileRunning": true
  },
  "simulationEpoch": "2026-10-09T00:00:00+00:00",
