      "id": "cs-flightstand",
      "name": "FlightStand",
      "type": "product",
      "definition": "colset FlightStand = product Flight * Stand timed;",
      "color": "#0d9488",
      "timed": true
    },
    {
      "id": "cs-turnfueller",
      "name": "TurnFueller",
      "type": "product",
      "definition": "colset TurnFueller = product Turnaround * Fueller timed;",
      "color": "#dc2626",
      "timed": true
    },
    {
      "id": "cs-turnbus",
      "name": "TurnBus",
      "type": "product",
      "definition": "colset TurnBus = product Turnaround * Bus timed;",
      "color": "#d97706",
      "timed": true
    },
    {
      "id": "cs-turncatering",
      "name": "TurnCatering",
      "type": "product",
      "definition": "colset TurnCatering = product Turnaround * CateringTruck timed;",
      "color": "#0f766e",
      "timed": true
    },
    {
      "id": "cs-turncleaning",
      "name": "TurnCleaning",
      "type": "product",
      "definition": "colset TurnCleaning = product Turnaround * CleaningTeam timed;",
      "color": "#16a34a",
      "timed": true
    },
    {
      "id": "cs-turnramp",
      "name": "TurnRamp",
      "type": "product",
      "definition": "colset TurnRamp = product Turnaround * RampTeam * Loader timed;",
      "color": "#ea580c",
      "timed": true
    },
    {
      "id": "cs-turnservice",
      "name": "TurnService",
      "type": "product",
      "definition": "colset TurnService = product Turnaround * ServiceTruck timed;",
      "color": "#0e7490",
      "timed": true
    },
    {
      "id": "cs-turntug",
      "name": "TurnTug",
      "type": "product",
      "definition": "colset TurnTug = product Turnaround * PushbackTug timed;",
      "color": "#ca8a04",
      "timed": true
    },
    {
      "id": "cs-turndeicer",
      "name": "TurnDeicer",
      "type": "product",
      "definition": "colset TurnDeicer = product Turnaround * DeicingTruck timed;",
      "color": "#0284c7",
      "timed": true
    }
  ],
  "variables": [
