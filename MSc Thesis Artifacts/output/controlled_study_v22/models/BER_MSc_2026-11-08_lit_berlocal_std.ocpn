            "height": 30
          },
          "includeInOcel": true
        },
        {
          "id": "a-t-final",
          "name": "Acquire Arrival\nRunway",
          "guard": "runway_fits(rw, fl.aircraft)",
          "time": "",
          "priority": "",
          "codeSegment": "// The turnaround object is created once the stand is known: from here on the\n// inbound leg, the outbound leg, the airframe and the stand travel together.\nlet dep_lh = fl.aircraft.body == \"wide\" || fl.aircraft.body == \"superheavy\";\nlet dep = fl;\ndep.id = \"DEP-\" + fl.studyCase;\ndep.direction = \"DEP\";\ndep.callsign = fl.pairedCallsign;\ndep.station = fl.pairedDestination;\nlet tr = #{\n    id: \"TA-\" + fl.id.sub_string(4),\n    arr: fl,\n    dep: dep,\n    stand: st,\n    upliftL: uplift_l(fl.aircraft.body, dep.sectorMin),\n    hold: hold_kind(fl.aircraft.typeCode, fl.carrierType),\n    nUlds: uld_count(hold_kind(fl.aircraft.typeCode, fl.carrierType), fl.aircraft.body, fl.pax),\n    nDepUlds: uld_count(hold_kind(fl.aircraft.typeCode, fl.carrierType), fl.aircraft.body, dep.pax),\n    // The boxes themselves are attached once they are actually worked, at unload.\n    ulds: [],\n    // Which optional services this rotation needs is decided once, here, so that the\n    // guards downstream are deterministic: a die rolled separately in two mutually\n    // exclusive guards can come up \"no\" in both and strand the token.\n    needCater: if dep_lh || fl.aircraft.body == \"wide\" || fl.aircraft.body == \"superheavy\" { true }\n               else if fl.carrierType == \"full\" { bernoulli(0.85) == 1 }\n               else { bernoulli(0.35) == 1 },\n    needWater: if dep.sectorMin > 300 { true } else { bernoulli(0.55) == 1 }\n};",
          "position": {
            "x": 870,
            "y": 300
          },
          "size": {
            "width": 50,
            "height": 30
          },
          "includeInOcel": true
        },
