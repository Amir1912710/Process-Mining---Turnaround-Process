          "codeSegment": "// Outbound containers, again from the pool; the turnaround ends up carrying every\n// box it handled, inbound and outbound.\nlet more = pick_ulds(pool, tr.dep.aircraft.body, tr.nDepUlds);\nlet all = tr.ulds;\nfor b in more { all.push(b); }\nlet tr2 = tr;\ntr2.ulds = all;",
          "position": {
            "x": 1760,
            "y": 200
          },
          "size": {
            "width": 50,
            "height": 30
          },
          "includeInOcel": true
        },
